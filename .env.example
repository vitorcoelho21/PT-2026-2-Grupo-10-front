# Copie este arquivo para ".env.local" e ajuste se necessário:
#   cp .env.example .env.local
#
# Endereço do back-end. Em Next.js, variáveis acessadas pelo navegador
# PRECISAM começar com NEXT_PUBLIC_.
# Depois de mudar este valor, reinicie o "npm run dev".
NEXT_PUBLIC_API_URL=http://localhost:3000
